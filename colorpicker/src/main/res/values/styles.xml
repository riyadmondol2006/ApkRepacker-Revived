<!--
  ~ Thin Material 3 Expressive overlays. The dialog keeps the colours of the host activity theme,
  ~ so the same overlay serves the light and the dark app theme; the "Dark" name is kept because
  ~ callers reference both style names.
  -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ResourceName">

  <style name="ColorPickerDialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog" />

  <style name="ColorPickerDialog.Dark" />

</resources>
