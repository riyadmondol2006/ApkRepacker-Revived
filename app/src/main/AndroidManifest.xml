<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">
    <!-- To access app permission: -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Shared storage. API 23-29: the classic runtime permissions (API 29 keeps legacy
         storage through requestLegacyExternalStorage). API 30+: "All files access", which
         the file manager needs to browse /sdcard; see utils/PermissionsUtils.kt. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- APK tool: lists every installed app, installs/uninstalls the APKs it builds. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Build / copy run as dataSync foreground services (local file processing). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep long patch/build runs alive in the background (asked for once, user-granted). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Revived.Light"
        tools:ignore="GoogleAppIndexingWarning"
        tools:targetApi="tiramisu">
        <activity
            android:name=".activity.MainActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.BaseActivity"
            android:exported="false" />
        <activity
            android:name=".activity.AppEditorActivity"
            android:exported="false"
            android:parentActivityName=".activity.MainActivity" />
        <activity
            android:name=".activity.ExceptionActivity"
            android:exported="false"
            android:label="@string/title_activity_exception" />
        <activity
            android:name=".activity.TextEditorActivity"
            android:exported="false"
            android:parentActivityName=".activity.MainActivity" />
        <activity
            android:name=".activity.CodeEditorActivity"
            android:exported="false"
            android:parentActivityName=".activity.MainActivity" />
        <activity
            android:name=".activity.ThemeEditorActivity"
            android:exported="false" />
        <activity
            android:name=".activity.EditorSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.imageviewer.ImageViewerActivity"
            android:exported="false" />

        <provider
            android:name=".utils.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
        <service
            android:name=".service.CopyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".service.BuildService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".service.PatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".service.DecompileService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".service.ProjectTransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <uses-library android:name="org.apache.http.legacy" android:required="true"/>
    </application>

</manifest>
