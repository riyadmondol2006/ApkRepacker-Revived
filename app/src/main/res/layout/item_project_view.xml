<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/project_card"
    style="@style/Widget.Revived.Card.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_margin"
    android:layout_marginEnd="@dimen/screen_margin"
    android:layout_marginTop="@dimen/b_group_gap"
    android:layout_marginBottom="@dimen/b_group_gap"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/list_item_min_height"
            android:paddingTop="@dimen/space_3"
            android:paddingBottom="@dimen/space_3"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_1">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/icon_app"
                android:layout_width="@dimen/b_icon_size"
                android:layout_height="@dimen/b_icon_size"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Revived.B.Circle"
                tools:src="@drawable/default_app_icon" />

            <TextView
                android:id="@+id/app_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintBottom_toTopOf="@id/app_pkg"
                app:layout_constraintEnd_toStartOf="@id/btn_expand"
                app:layout_constraintStart_toEndOf="@id/icon_app"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="@string/app_name" />

            <TextView
                android:id="@+id/app_pkg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintBottom_toTopOf="@id/app_version"
                app:layout_constraintEnd_toEndOf="@id/app_name"
                app:layout_constraintStart_toStartOf="@id/app_name"
                app:layout_constraintTop_toBottomOf="@id/app_name"
                tools:text="com.riyadm.apkrepacker" />

            <TextView
                android:id="@+id/app_version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorPrimary"
                app:layout_constraintBottom_toTopOf="@id/app_patch"
                app:layout_constraintEnd_toEndOf="@id/app_name"
                app:layout_constraintStart_toStartOf="@id/app_name"
                app:layout_constraintTop_toBottomOf="@id/app_pkg"
                tools:text="1.0 (10)" />

            <TextView
                android:id="@+id/app_patch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/app_name"
                app:layout_constraintStart_toStartOf="@id/app_name"
                app:layout_constraintTop_toBottomOf="@id/app_version"
                tools:text="/storage/emulated/0/ApkRepacker/projects/Apk Repacker_src" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_expand"
                style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/project_actions_toggle"
                app:icon="@drawable/ic_m3_expand_more"
                app:iconTint="?attr/colorOnSecondaryContainer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/menu_expand_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_3"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButtonGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_build"
                    style="@style/Widget.Revived.B.ProjectAction.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/menu_build_app"
                    app:icon="@drawable/ic_build" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_about_project"
                    style="@style/Widget.Revived.B.ProjectAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/menu_about_project"
                    app:icon="@drawable/ic_info" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_delete"
                    style="@style/Widget.Revived.B.ProjectAction.Destructive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/menu_delete_project"
                    app:icon="@drawable/ic_delete" />
            </com.google.android.material.button.MaterialButtonGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_export"
                style="@style/Widget.Revived.B.ProjectAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/menu_export_project"
                app:icon="@drawable/ic_m3_export" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
