<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/fab_clearance">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_marginTop="@dimen/space_2"
                android:layout_marginBottom="@dimen/space_2"
                android:text="@string/management"
                android:textAppearance="@style/TextAppearance.Revived.SectionHeader" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/action_settings"
                style="@style/Widget.Revived.E.Tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_item_min_height"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_5">

                    <com.google.android.material.card.MaterialCardView
                            android:id="@+id/settings_icon"
                            style="@style/Widget.Material3.CardView.Filled"
                            android:layout_width="@dimen/e_tile_icon_size"
                            android:layout_height="@dimen/e_tile_icon_size"
                            app:cardBackgroundColor="?attr/colorPrimary"
                            app:cardElevation="0dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Revived.E.IconContainer"
                            app:strokeWidth="0dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="@dimen/space_6"
                                android:layout_height="@dimen/space_6"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_settings"
                                app:tint="?attr/colorOnPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge.Emphasized"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/m3e_tools_settings_hint"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/action_check_for_updates"
                    style="@style/Widget.Revived.E.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_1"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/e_tile_min_height"
                        android:orientation="vertical"
                        android:padding="@dimen/space_5">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/updates_icon"
                            style="@style/Widget.Material3.CardView.Filled"
                            android:layout_width="@dimen/e_tile_icon_size"
                            android:layout_height="@dimen/e_tile_icon_size"
                            app:cardBackgroundColor="?attr/colorSecondary"
                            app:cardElevation="0dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Revived.E.IconContainer"
                            app:strokeWidth="0dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="@dimen/space_6"
                                android:layout_height="@dimen/space_6"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_update"
                                app:tint="?attr/colorOnSecondary" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/about_check_updates"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
                            android:textColor="?attr/colorOnSecondaryContainer" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/m3e_tools_updates_hint"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/action_about"
                    style="@style/Widget.Revived.E.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_1"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorTertiaryContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/e_tile_min_height"
                        android:orientation="vertical"
                        android:padding="@dimen/space_5">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/about_icon"
                            style="@style/Widget.Material3.CardView.Filled"
                            android:layout_width="@dimen/e_tile_icon_size"
                            android:layout_height="@dimen/e_tile_icon_size"
                            app:cardBackgroundColor="?attr/colorTertiary"
                            app:cardElevation="0dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Revived.E.IconContainer"
                            app:strokeWidth="0dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="@dimen/space_6"
                                android:layout_height="@dimen/space_6"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_info"
                                app:tint="?attr/colorOnTertiary" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/about_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
                            android:textColor="?attr/colorOnTertiaryContainer" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/m3e_tools_about_hint"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnTertiaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
