<?xml version="1.0" encoding="utf-8"?>
<!-- One tappable row of the About screen. Corner shape is set per position by AboutFragment. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/about_row"
    style="@style/Widget.Revived.Card.GroupRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/shape_corner_extra_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/pref_row_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/pref_row_padding_horizontal"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/pref_row_padding_horizontal"
        android:paddingBottom="@dimen/space_2">

        <FrameLayout
            android:layout_width="@dimen/about_row_icon_container"
            android:layout_height="@dimen/about_row_icon_container"
            android:background="@drawable/m3_preview_oval"
            android:backgroundTint="?attr/colorSecondaryContainer">

            <ImageView
                android:id="@+id/about_row_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="?attr/colorOnSecondaryContainer"
                tools:src="@drawable/ic_link" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/about_row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="GitHub" />

            <TextView
                android:id="@+id/about_row_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="github.com/riyadmondol2006"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
