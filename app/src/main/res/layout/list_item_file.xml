<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.listitem.ListItemLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_margin"
    android:layout_marginEnd="@dimen/screen_margin"
    android:layout_marginTop="1dp"
    android:layout_marginBottom="1dp">

    <com.google.android.material.listitem.ListItemCardView
        android:id="@+id/file_row"
        style="?attr/listItemCardViewSegmentedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/list_item_min_height"
        android:checkable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.riyadm.apkrepacker.ui.widget.SelectableIconTile
                android:id="@+id/list_item_image"
                android:layout_width="@dimen/list_item_leading_size"
                android:layout_height="@dimen/list_item_leading_size"
                android:contentDescription="@null"
                tools:cardBackgroundColor="?attr/colorSecondaryContainer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/list_item_name"
                    style="@style/Widget.Material3.TextView.ListItem.LabelText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    tools:text="AndroidManifest.xml" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/list_item_size"
                        style="@style/Widget.Material3.TextView.ListItem.SupportingText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_2"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        tools:text="10 MB" />

                    <TextView
                        android:id="@+id/list_item_date"
                        style="@style/Widget.Material3.TextView.ListItem.SupportingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:maxLines="1"
                        tools:text="Jul 22, 2020" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/list_item_chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/space_2"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.listitem.ListItemCardView>
</com.google.android.material.listitem.ListItemLayout>
