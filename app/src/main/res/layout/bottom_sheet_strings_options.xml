<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_4">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_6"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_6"
            android:paddingBottom="@dimen/space_1"
            android:text="@string/h_section_strings"
            android:textAppearance="@style/TextAppearance.Revived.SectionHeader" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_new_string"
            style="@style/Widget.Revived.SheetAction"
            android:text="@string/action_add_new_string"
            app:icon="@drawable/ic_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_with"
            style="@style/Widget.Revived.SheetAction"
            android:text="@string/action_open_with"
            app:icon="@drawable/ic_open_with" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_6"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_6"
            android:paddingBottom="@dimen/space_1"
            android:text="@string/h_section_language"
            android:textAppearance="@style/TextAppearance.Revived.SectionHeader" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_new_language"
            style="@style/Widget.Revived.SheetAction"
            android:text="@string/action_add_new_lang"
            app:icon="@drawable/ic_add" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_6"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_6"
            android:paddingBottom="@dimen/space_1"
            android:text="@string/h_section_translate"
            android:textAppearance="@style/TextAppearance.Revived.SectionHeader" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auto_translate_language"
            style="@style/Widget.Revived.SheetAction"
            android:text="@string/action_auto_translate_lang"
            app:icon="@drawable/ic_translate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auto_translate_language_with"
            style="@style/Widget.Revived.SheetAction"
            android:text="@string/action_auto_translate_lang_dictionary"
            app:icon="@drawable/ic_dictionary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_as_dictionary"
            style="@style/Widget.Revived.SheetAction"
            android:text="@string/action_save_as_dictionary"
            app:icon="@drawable/ic_save_white" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
