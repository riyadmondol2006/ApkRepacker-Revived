<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/fab_clearance">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Revived.E.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="@string/search_request"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/search_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/path_layout"
                style="@style/Widget.Revived.E.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:hint="@string/m3e_folder"
                app:endIconContentDescription="@string/m3e_pick_folder"
                app:endIconDrawable="@drawable/ic_folder_open_white"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Revived.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/caption_search_options"
                        android:textAppearance="@style/TextAppearance.Revived.SectionHeader" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/search_file_cb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/files"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

                    <LinearLayout
                        android:id="@+id/search_options_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/caption_string_search_options"
                            android:textAppearance="@style/TextAppearance.Revived.SectionHeader" />

                        <com.google.android.material.chip.ChipGroup
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/regular_exp_cb"
                                style="@style/Widget.Revived.E.FilterChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/regex" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/ignore_case_cb"
                                style="@style/Widget.Revived.E.FilterChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/case_sensitive" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/whole_words_only_cb"
                                style="@style/Widget.Revived.E.FilterChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/whole_words_only" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/recursively_cb"
                                style="@style/Widget.Revived.E.FilterChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recursively" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Revived.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_ext"
                        android:textAppearance="@style/TextAppearance.Revived.SectionHeader" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/ext_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:animateLayoutChanges="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_add_ext"
                        style="@style/Widget.Material3Expressive.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/add_ext"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_go_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="@dimen/screen_margin"
        android:text="@string/action_search"
        app:icon="@drawable/ic_search" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
