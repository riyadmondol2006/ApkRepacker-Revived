<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the decompile log. Tap copies the line. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_4"
    android:paddingEnd="@dimen/space_4"
    android:paddingTop="@dimen/space_1"
    android:paddingBottom="@dimen/space_1">

    <TextView
        android:id="@+id/logitemText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="monospace"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?attr/colorOnSurface"
        android:textIsSelectable="true" />
</FrameLayout>
