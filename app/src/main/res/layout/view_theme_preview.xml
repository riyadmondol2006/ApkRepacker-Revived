<?xml version="1.0" encoding="utf-8"?>
<!-- A miniature M3 screen. ThemeView inflates it with a context wrapped in the previewed theme, so every
     ?attr colour below resolves to that theme's real palette. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/theme_preview_height"
    android:background="?attr/colorSurface"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="28dp">

        <!-- top app bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/m3_preview_oval"
                android:backgroundTint="?attr/colorOnSurfaceVariant" />

            <View
                android:layout_width="56dp"
                android:layout_height="8dp"
                android:layout_marginStart="@dimen/space_2"
                android:background="@drawable/m3_preview_pill"
                android:backgroundTint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- hero card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_3"
            android:layout_weight="1"
            android:background="@drawable/m3_preview_card"
            android:backgroundTint="?attr/colorPrimaryContainer"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3"
            android:paddingEnd="@dimen/space_3">

            <View
                android:layout_width="64dp"
                android:layout_height="8dp"
                android:background="@drawable/m3_preview_pill"
                android:backgroundTint="?attr/colorOnPrimaryContainer" />

            <View
                android:layout_width="96dp"
                android:layout_height="6dp"
                android:layout_marginTop="@dimen/space_2"
                android:alpha="0.6"
                android:background="@drawable/m3_preview_pill"
                android:backgroundTint="?attr/colorOnPrimaryContainer" />
        </LinearLayout>

        <!-- chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal">

            <View
                android:layout_width="30dp"
                android:layout_height="14dp"
                android:background="@drawable/m3_preview_pill"
                android:backgroundTint="?attr/colorSecondaryContainer" />

            <View
                android:layout_width="30dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/space_1"
                android:background="@drawable/m3_preview_pill"
                android:backgroundTint="?attr/colorTertiaryContainer" />

            <View
                android:layout_width="30dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/space_1"
                android:background="@drawable/m3_preview_pill"
                android:backgroundTint="?attr/colorSurfaceContainerHighest" />
        </LinearLayout>
    </LinearLayout>

    <!-- primary action -->
    <View
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/space_3"
        android:layout_marginBottom="36dp"
        android:background="@drawable/m3_preview_card"
        android:backgroundTint="?attr/colorPrimary" />

    <!-- navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurfaceContainer"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="26dp"
            android:layout_height="12dp"
            android:background="@drawable/m3_preview_pill"
            android:backgroundTint="?attr/colorSecondaryContainer" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="@dimen/space_5"
            android:background="@drawable/m3_preview_oval"
            android:backgroundTint="?attr/colorOnSurfaceVariant" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="@dimen/space_5"
            android:background="@drawable/m3_preview_oval"
            android:backgroundTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</FrameLayout>
