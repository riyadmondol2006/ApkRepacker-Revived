<?xml version="1.0" encoding="utf-8"?>
<!-- App identity block shared by About and the project info page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_4"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_6">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/tv_about_app_icon"
        android:layout_width="@dimen/about_icon_size"
        android:layout_height="@dimen/about_icon_size"
        android:background="?attr/colorPrimaryContainer"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        app:shapeAppearance="?attr/shapeAppearanceCornerExtraLarge"
        tools:src="@mipmap/ic_launcher_round" />

    <TextView
        android:id="@+id/tv_about_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tv_about_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Version 1.0.2(20)" />
</LinearLayout>
