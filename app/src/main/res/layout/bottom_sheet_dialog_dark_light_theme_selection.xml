<?xml version="1.0" encoding="utf-8"?>
<!-- Auto theme: pick the theme used while the system is light and the one used while it is dark. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_4">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:paddingBottom="@dimen/space_4"
            android:text="@string/auto_theme_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge.Emphasized"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/label_dl_light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_2"
                    android:drawablePadding="@dimen/space_2"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_1"
                    android:text="@string/auto_theme_light_theme"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    app:drawableStartCompat="@drawable/ic_light_theme"
                    app:drawableTint="?attr/colorPrimary" />

                <com.riyadm.apkrepacker.ui.themelist.ThemeView
                    android:id="@+id/theme_view_dl_selection_light"
                    style="@style/Widget.Revived.Card.ThemePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/label_dl_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_2"
                    android:drawablePadding="@dimen/space_2"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_1"
                    android:text="@string/auto_theme_dark_theme"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    app:drawableStartCompat="@drawable/ic_dark_theme_2"
                    app:drawableTint="?attr/colorPrimary" />

                <com.riyadm.apkrepacker.ui.themelist.ThemeView
                    android:id="@+id/theme_view_dl_selection_dark"
                    style="@style/Widget.Revived.Card.ThemePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="@dimen/space_6"
            android:paddingEnd="@dimen/space_4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_dl_cancel"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_dl_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/ok" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
