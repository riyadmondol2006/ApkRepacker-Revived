<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    tools:context=".fragment.CompileFragment">

    <!-- Status: tonal card that turns into the result (primary container / error container). -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/compile_status_card"
        style="@style/Widget.Revived.Card.Filled"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width"
        app:shapeAppearance="@style/ShapeAppearance.Revived.Card.Large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="@dimen/space_4">

                    <com.google.android.material.loadingindicator.LoadingIndicator
                        android:id="@+id/compile_loading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageView
                        android:id="@+id/compile_result_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/progress_tip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/compile_in_progress"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/compile_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/compile_progress"
                style="@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/message_build_file_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:visibility="gone"
                tools:text="App built in 00:12" />

            <TextView
                android:id="@+id/message_build_file_saved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textIsSelectable="true"
                android:visibility="gone"
                tools:text="File saved to: /storage/emulated/0/ApkRepacker/output/out.apk" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/compile_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@+id/compile_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/compile_status_card"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <!-- Step list: a check springs in as each step completes. -->
        <LinearLayout
            android:id="@+id/compile_steps_section"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_2"
                android:paddingBottom="@dimen/space_2"
                android:text="@string/m3d_steps_title"
                android:textAppearance="@style/TextAppearance.Revived.SectionHeader" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Revived.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/compile_steps"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="@dimen/space_2"
                    tools:listitem="@layout/item_build_step" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Build errors: monospace lines on a surface container card. -->
        <LinearLayout
            android:id="@+id/compile_error_section"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_2"
                android:paddingBottom="@dimen/space_2"
                android:text="@string/m3d_build_log_title"
                android:textAppearance="@style/TextAppearance.Revived.SectionHeader" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Revived.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/error_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="@dimen/space_2"
                    android:paddingBottom="@dimen/space_2"
                    tools:listitem="@layout/list_item_error" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/compile_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/screen_margin"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:id="@+id/compile_primary_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_install"
                style="@style/Widget.Material3Expressive.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:text="@string/install_app"
                app:icon="@drawable/ic_install"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:text="@string/m3d_share"
                app:icon="@drawable/ic_share"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remove"
            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/uninstall_app"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_show_log"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_show_log" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_log"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:text="@string/action_copy_log" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_close"
                style="@style/Widget.Material3Expressive.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:text="@string/close" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
