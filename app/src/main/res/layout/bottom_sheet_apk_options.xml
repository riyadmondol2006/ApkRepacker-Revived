<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_4">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        android:paddingBottom="@dimen/space_2">

        <TextView
            android:id="@+id/sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/apk_options_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge.Emphasized"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/sheet_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_2"
        android:paddingEnd="@dimen/space_2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/decompile_app"
            style="@style/Widget.Revived.SheetAction"
            android:text="@string/decompile_app"
            app:icon="@drawable/ic_decompile" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/simple_edit_apk"
            style="@style/Widget.Revived.SheetAction"
            android:text="@string/simple_edit_app"
            app:icon="@drawable/ic_rename" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/install_app"
            style="@style/Widget.Revived.SheetAction"
            android:text="@string/install_app"
            app:icon="@drawable/ic_install" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sign_app"
            style="@style/Widget.Revived.SheetAction"
            android:text="@string/sign_app"
            app:icon="@drawable/ic_sign" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/set_as_framework_app"
            style="@style/Widget.Revived.SheetAction"
            android:text="@string/install_as_framework"
            app:icon="@drawable/ic_framework" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_item"
            style="@style/Widget.Revived.B.SheetAction.Destructive"
            android:text="@string/action_delete"
            app:icon="@drawable/ic_delete" />
    </LinearLayout>
</LinearLayout>
