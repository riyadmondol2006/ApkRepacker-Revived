<?xml version="1.0" encoding="utf-8"?>
<!-- Code editor shell: open-files drawer (start), editor with toolbar, find bar and a floating symbol toolbar,
     project tree drawer (end). The window insets are already applied to the content view by EdgeToEdgeUtils. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/editor_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:navigationContentDescription="@string/m3f_open_files"
                    app:navigationIcon="@drawable/ic_m3_menu"
                    app:title="@string/code_editor" />
            </com.google.android.material.appbar.AppBarLayout>

            <com.jecelyin.editor.v2.manager.EditorPager
                android:id="@+id/tab_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/editor_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:clipChildren="false"
                android:orientation="vertical">

                <include
                    android:id="@+id/find_panel"
                    layout="@layout/editor_find_panel" />

                <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
                    android:id="@+id/symbol_toolbar"
                    style="?attr/floatingToolbarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_marginEnd="@dimen/space_3"
                    android:layout_marginTop="@dimen/space_2"
                    android:layout_marginBottom="@dimen/space_2"
                    app:marginBottomSystemWindowInsets="false"
                    app:marginLeftSystemWindowInsets="false"
                    app:marginRightSystemWindowInsets="false"
                    app:marginTopSystemWindowInsets="false">

                    <HorizontalScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <com.jecelyin.editor.v2.widget.SymbolBarLayout
                            android:id="@+id/symbolBarLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </HorizontalScrollView>
                </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Open files -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/left_navigation_view"
        android:layout_width="@dimen/m3f_drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="false">

        <LinearLayout
            android:id="@+id/left_navigation_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/list_item_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_6"
                android:paddingEnd="@dimen/space_2"
                android:paddingTop="@dimen/space_3"
                android:paddingBottom="@dimen/space_2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/open_files_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/m3f_open_files"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge.Emphasized"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/open_files_project"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_files_menu"
                    style="@style/Widget.Material3Expressive.Button.IconButton.Standard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/m3f_more_actions"
                    app:icon="@drawable/ic_more"
                    app:iconTint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/open_tabs_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/space_3"
                    android:paddingEnd="@dimen/space_3"
                    android:paddingBottom="@dimen/space_4" />

                <TextView
                    android:id="@+id/open_tabs_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/m3f_no_open_files"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

    <!-- Project tree (ProjectTreeStructureFragment is placed here) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/right_navigation_view"
        android:layout_width="@dimen/m3f_project_drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:fitsSystemWindows="false">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/project_tree_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
