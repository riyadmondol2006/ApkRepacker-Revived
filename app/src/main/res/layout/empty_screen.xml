<?xml version="1.0" encoding="utf-8"?>
<!-- Illustrated empty state. Ids: empty_icon, empty_title, empty_message, empty_action (hidden until a screen shows it). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        tools:ignore="UselessParent">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Revived.IllustrationContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/empty_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_folder_empty"
                app:tint="?attr/colorOnSecondaryContainer" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center"
            android:text="@string/project_list_is_empty"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:text="@string/empty_screen_hint"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/empty_action"
            style="@style/Widget.Material3Expressive.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:text="@string/empty_screen_action"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
