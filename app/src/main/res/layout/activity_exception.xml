<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.ExceptionActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/appbar"
            layout="@layout/appbar" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/exception_scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="@dimen/space_6"
                android:paddingBottom="@dimen/space_4">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/crash_icon_container"
                    style="@style/Widget.Revived.IllustrationContainer.Error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_m3_bug_report"
                        app:tint="?attr/colorOnErrorContainer"
                        tools:ignore="UseAppTint" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/crash_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:gravity="center"
                    android:text="@string/crash_title"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium.Emphasized"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/crash_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="center"
                    android:text="@string/crash_message"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Revived.Card.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:shapeAppearance="@style/ShapeAppearance.Revived.Card.Large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_4">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/crash_report_label"
                            android:textAppearance="@style/TextAppearance.Revived.SectionHeader" />

                        <TextView
                            android:id="@+id/error_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:textAppearance="@style/TextAppearance.Revived.Monospace"
                            android:textIsSelectable="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="@dimen/space_3"
        android:paddingBottom="@dimen/space_3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_restart"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crash_action_restart"
            app:icon="@drawable/ic_refresh" />

        <com.google.android.material.button.MaterialButtonGroup
            style="@style/Widget.Material3Expressive.MaterialButtonGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_log"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_copy_log"
                app:icon="@drawable/ic_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_log"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/crash_action_share"
                app:icon="@drawable/ic_share" />
        </com.google.android.material.button.MaterialButtonGroup>
    </LinearLayout>
</LinearLayout>
