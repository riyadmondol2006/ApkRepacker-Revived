<?xml version="1.0" encoding="utf-8"?>
<!-- Header of the navigation rail: the menu button that expands / collapses it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_4"
    android:paddingEnd="@dimen/space_4"
    android:paddingBottom="@dimen/space_2">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nav_rail_toggle"
        style="@style/Widget.Material3Expressive.Button.IconButton.Standard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/nav_rail_expand"
        app:icon="@drawable/ic_m3_menu" />
</FrameLayout>
