<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the open-files drawer. The checked state (selected tab) turns the card tonal. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Revived.Card.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_1"
    android:layout_marginBottom="@dimen/space_1"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/m3f_tab_card_background"
    app:checkedIcon="@null"
    app:shapeAppearance="@style/ShapeAppearance.Revived.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_1"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_2">

        <ImageView
            android:id="@+id/list_item_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/m3f_file_type_icon"
            android:tint="?attr/colorOnSurfaceVariant"
            tools:src="@drawable/ic_java" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="Main.java" />

            <TextView
                android:id="@+id/file_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="/storage/emulated/0/project/src/Main.java" />
        </LinearLayout>

        <ImageView
            android:id="@+id/unsaved_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_2"
            android:contentDescription="@string/m3f_unsaved_changes"
            android:src="@drawable/m3f_unsaved_dot"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close"
            style="@style/Widget.Material3Expressive.Button.IconButton.Standard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/m3f_close_tab"
            app:icon="@drawable/ic_close"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
