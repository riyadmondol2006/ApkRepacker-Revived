<?xml version="1.0" encoding="utf-8"?>
<!-- File rows: the stock segmented container is colorSurface, which vanishes on the colorSurface page
     and leaves the row content double-indented. A container tone keeps the segments visible. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorSecondaryContainer" android:state_checkable="true" android:state_checked="true" />
    <item android:color="?attr/colorSurfaceContainer" />
</selector>
