    <!-- All files access -->
    <string name="transfer_access_title">Allow access to all files?</string>
    <string name="transfer_access_message">With All files access the app can read and write the folder you pick directly, which is much faster for big projects. You can still continue without it.</string>
    <string name="transfer_access_grant">Allow</string>
    <string name="transfer_access_continue">Continue without</string>
    <string name="pref_all_files_access">All files access</string>
    <string name="pref_all_files_access_granted">Allowed. The file manager and project export/import can use any folder.</string>
    <string name="pref_all_files_access_denied">Not allowed. Tap to allow access to all files.</string>

    <!-- Split APK apps -->
    <string name="apps_badge_split">Split</string>
    <string name="split_warning_title">Split APK app</string>
    <string name="split_warning_message">%1$s is installed as split APKs: a base APK plus separate configuration splits.\n\nThe base and its configuration splits (native libraries, screen density and language resources) are merged into one project, and the split requirement is removed when you rebuild, so the result installs as a single APK. Dynamic feature splits are not included, and the rebuilt app is signed with your key, so it can\'t be installed over the original.</string>
    <string name="split_warning_continue">Decompile anyway</string>
