<?xml version="1.0" encoding="utf-8"?>
<!-- Shared M3 Expressive widget styles. Only what the Expressive theme doesn't already give by default:
     plain MaterialButton / FAB / Switch / Slider / BottomNavigationView / Toolbar pick Expressive styles from the theme. -->
<resources>
    <!-- Cards -->
    <style name="ShapeAppearance.Revived.Card" parent="ShapeAppearance.Material3.Corner.Large" />
    <style name="ShapeAppearance.Revived.Card.Large" parent="ShapeAppearance.Material3.Corner.ExtraLarge" />

    <style name="Widget.Revived.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.Revived.Card</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
    </style>
    <style name="Widget.Revived.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.Revived.Card</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    </style>
    <style name="Widget.Revived.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearance">@style/ShapeAppearance.Revived.Card</item>
    </style>
    <!-- Grouped list row card: full-bleed, no outline, used for segmented lists -->
    <style name="Widget.Revived.Card.ListItem" parent="Widget.Revived.Card.Filled">
        <item name="android:layout_marginStart">@dimen/screen_margin</item>
        <item name="android:layout_marginEnd">@dimen/screen_margin</item>
        <item name="android:layout_marginTop">@dimen/space_1</item>
        <item name="android:layout_marginBottom">@dimen/space_1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Text fields: outlined, rounded medium; filled variant for dense dialogs -->
    <style name="Widget.Revived.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox" />
    <style name="Widget.Revived.TextInput.Dense" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense" />
    <style name="Widget.Revived.TextInput.Filled" parent="Widget.Material3.TextInputLayout.FilledBox" />

    <!-- Section header in lists / sheets -->
    <style name="TextAppearance.Revived.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Bottom sheet action row (icon + label) -->
    <style name="Widget.Revived.SheetAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="iconPadding">@dimen/space_4</item>
        <item name="iconGravity">textStart</item>
    </style>
</resources>
